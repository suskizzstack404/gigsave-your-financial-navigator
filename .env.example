# GigSave — environment variables
# Copy this file to .env and fill in the values from your Supabase project
# (Settings → API in the Supabase dashboard, or Lovable Cloud).
# Never commit your real .env file.

# ---------------------------------------------------------------------------
# Client-side (exposed to the browser — must be prefixed with VITE_)
# ---------------------------------------------------------------------------

# Your Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable/anon key (safe to expose in the browser)
VITE_SUPABASE_PUBLISHABLE_KEY=

# GigSave AI Assistant — Groq API key, called directly from the browser.
# Get one at https://console.groq.com/keys
# ⚠️  This ships inside the JS bundle and is visible to anyone who inspects
# the network tab or built files. Fine for personal/local use; if this app
# gets real traffic, move this call behind a server-side proxy instead so
# the key never reaches the browser.
VITE_GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Server-side only (used in server routes / middleware — never exposed
# to the client bundle). These are read via process.env, so they should
# NOT be prefixed with VITE_.
# ---------------------------------------------------------------------------

# Same Supabase project URL as above
SUPABASE_URL=

# Same value as VITE_SUPABASE_PUBLISHABLE_KEY, used by server middleware
SUPABASE_PUBLISHABLE_KEY=

# Supabase service role key — bypasses Row Level Security.
# SECRET: keep this out of the client bundle and out of version control.
SUPABASE_SERVICE_ROLE_KEY=
